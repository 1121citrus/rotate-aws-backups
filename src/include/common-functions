#!/usr/bin/env bash
# shellcheck shell=bash
# shellcheck disable=SC1090,SC1091

# Compatibility shim for legacy src/include/common-functions imports.
# Canonical implementation now lives at include/common-functions.

_common_source_path() {
    local this_file include_root candidate repo_root

    this_file="${BASH_SOURCE[0]}"
    include_root="${INCLUDE_DIR:-/usr/local/include}"
    candidate="${include_root}/common-functions"

    # Avoid self-sourcing loops when tests set INCLUDE_DIR=src/include.
    if command -v realpath >/dev/null 2>&1; then
        local this_real candidate_real
        this_real="$(realpath "${this_file}" 2>/dev/null || echo "${this_file}")"
        candidate_real="$(realpath "${candidate}" 2>/dev/null || echo "${candidate}")"
        if [[ "${candidate_real}" != "${this_real}" ]] && [[ -r "${candidate}" ]]; then
            printf '%s\n' "${candidate}"
            return 0
        fi
    elif [[ -r "${candidate}" ]] && [[ "${candidate}" != "${this_file}" ]]; then
        printf '%s\n' "${candidate}"
        return 0
    fi

    repo_root="$(cd "$(dirname "${this_file}")/../.." >/dev/null 2>&1 && pwd)"
    if [[ -r "${repo_root}/include/common-functions" ]]; then
        printf '%s\n' "${repo_root}/include/common-functions"
        return 0
    fi

    return 1
}

if ! _common_target="$(_common_source_path)"; then
    echo "ERROR: unable to locate include/common-functions" >&2
    if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
        return 1
    fi
    exit 1
fi

# shellcheck disable=SC1090
source "${_common_target}"

unset _common_target
unset -f _common_source_path
